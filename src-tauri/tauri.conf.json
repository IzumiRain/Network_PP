{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Network++",
  "version": "1.1.0",
  "identifier": "io.github.networkpp.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Network++",
        "width": 1120,
        "height": 740,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#0c0d0e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
